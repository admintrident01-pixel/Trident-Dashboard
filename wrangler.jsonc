{
  "name": "trident-dashboard",
  "main": "worker/schedule-live.js",
  "compatibility_date": "2026-10-08",
  "durable_objects": {"bindings": [{"name": "SCHEDULE_ROOM", "class_name": "ScheduleRoom"}]},
  "migrations": [{"tag": "schedule-live-v1", "new_sqlite_classes": ["ScheduleRoom"]}],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/schedule-live", "/__schedule-publish"]
  }
}
